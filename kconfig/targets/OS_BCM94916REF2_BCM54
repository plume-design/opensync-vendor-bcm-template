@include "base_bcm4916"
CONFIG_3RDPARTY_COGNITIVE=y
CONFIG_3RDPARTY_OOKLA=y
CONFIG_3RDPARTY_SAMKNOWS=y
CONFIG_BCMWL_EHT_FEATURES="127"
CONFIG_FM_FLASH_SYSLOG_SIZE=2048
CONFIG_FM_RAM_SYSLOG_SIZE=2048
# CONFIG_IPERF_LHOST_ACCEL is not set
CONFIG_MANAGER_FM=y
CONFIG_MANAGER_NFM=y
CONFIG_MANAGER_WANO_IFACE_LIST="eth4 eth0 eth1 eth2 eth3"
CONFIG_OSBUS_LIB=y
CONFIG_OSBUS_RBUS=y
CONFIG_OSN_BACKEND_FW_IPTABLES_THIN=y
CONFIG_OSP_UPG_GEN=y
CONFIG_PM_ENABLE_OBJM=y
CONFIG_PM_GW_OFFLINE_CFG=y
CONFIG_PSFS_PRESERVE_DIR="/mnt/data/pstore"
CONFIG_REVSSH_DROPBEAR_KEYFILE="/etc/dropbear/dropbear_rsa_host_key"
CONFIG_TARGET_ENABLE_EBTABLES=y
CONFIG_TARGET_MODEL="BCM94916REF2"
CONFIG_TARGET_NAME="BCM94916REF2"
CONFIG_TARGET_PATH_LOG_STATE="/tmp/log-state.conf"
CONFIG_TARGET_SUPPORT_WIFI7=y
CONFIG_USE_OSBUS=y
CONFIG_VENDOR_IS_BCM_TEMPLATE=y
CONFIG_TARGET_ETH4_LIST=y
CONFIG_TARGET_ETH4_NAME="eth4"
CONFIG_BCM_NVRAM_UNIFIED=y
