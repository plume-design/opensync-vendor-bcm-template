#!/bin/sh

# nvram config if mlo is enabled
# Need to run before wifi driver is loaded
# which is loaded by S99opensync.

start()
{
   # Enable MLO by default
   # These numbers represent order of radios as per indices.
   # First value refers to wl0. Second to wl1, etc.
   # 0 means "primary radio for MLO", 1 means "secondary", etc.
   # 0 is expected to be assigned to the radios that has the
   # highest transport throughput, eg. 6GHz on PCI (refer to BCM
   # recommendentation if unsure). Assuming wl0=5G, wl1=6G, wl2=2.4G,
   # "1 0 2" ("wl0=1 wl1=0 wl2=2") which means wl1 is Main Link
   # wl2 is the Aux1 link and wl2 is the Aux2 link
   nvram kset wl_mlo_config="1 0 2 -1"
   nvram kcommit
}

case "$1" in
    start)
        start
        exit 0
        ;;

    *)
        echo "$0: unrecognized option $1"
        exit 1
        ;;
esac
