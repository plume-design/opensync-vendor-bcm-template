#!/bin/sh

export PATH="/opt/sbin:/opt/bin:/usr/sbin:/sbin:/usr/bin:/bin/:$PATH"

start()
{
    echo "Starting syslogd $(which syslogd) and klogd $(which klogd) ..."
    if ! syslogd -s 1024 -C256 -O /var/log/messages -S -b 1; then
        echo "syslogd has no support for shared memory cyclic buffer (-C)"
        syslogd -s 1024 -O /var/log/messages -S -b 1
    fi
    klogd
}

stop()
{
    echo "Stopping syslogd ..."
    killall syslogd
    killall klogd
}


case "$1" in
    start)
        start
        exit 0
        ;;

    stop)
        stop
        exit 0
        ;;

    *)
        echo "$0: unrecognized option $1"
        exit 1
        ;;
esac
